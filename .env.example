# Скопируйте в .env для локальной разработки.
# На Railway эти же ключи задаются в Variables у сервиса.

# --- База данных ---------------------------------------------------------
# Railway: добавьте плагин MySQL и подставьте ${{MySQL.MYSQL_URL}}.
DATABASE_URL=mysql://user:password@host:3306/school911

# --- Сессии --------------------------------------------------------------
# Любая длинная случайная строка. Смена значения разлогинивает всех.
# Сгенерировать: openssl rand -hex 32
JWT_SECRET=

# --- Вход через Telegram -------------------------------------------------
# 1. Напишите @BotFather команду /newbot и получите токен.
# 2. Отправьте /setdomain и укажите домен деплоя — без этого виджет не работает.
# 3. Username бота указывается без символа @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Владелец проекта: `tg:` плюс числовой Telegram ID (узнать у @userinfobot).
# Даёт право выдавать и отзывать роли администраторов и редакторов.
OWNER_OPEN_ID=tg:000000000

# Либо вместо числового ID укажите свой username без @. Первый вход с этим
# username забирает права владельца и записывает числовой ID в базу; после
# этого username больше ничего не даёт. Удобно на первом деплое, когда ID
# ещё неизвестен.
OWNER_TELEGRAM_USERNAME=

# --- Хранилище файлов ----------------------------------------------------
# Если блок S3 не заполнен, файлы пишутся на локальный диск в STORAGE_DIR.
# На Railway укажите сюда путь примонтированного тома, иначе файлы пропадут
# при передеплое.
STORAGE_DIR=./storage

# Любой S3-совместимый сервис: Yandex Object Storage, Selectel, VK Cloud,
# Cloudflare R2, Backblaze B2, MinIO. Заполните все четыре — бэкенд
# переключится на S3 автоматически, менять код не нужно.
#   Yandex:     https://storage.yandexcloud.net        (S3_REGION=ru-central1)
#   Selectel:   https://s3.ru-1.storage.selcloud.ru    (S3_REGION=ru-1)
#   Cloudflare: https://<account_id>.r2.cloudflarestorage.com  (S3_REGION=auto)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Публичный домен бакета, если он раздаётся напрямую. Если пусто, файлы
# отдаются через подписанные ссылки с нашего сервера.
S3_PUBLIC_URL=

# Картинка баннера в шапке. Если пусто, рисуется текстовый вариант.
VITE_BANNER_IMAGE_URL=

# --- Служебное -----------------------------------------------------------
# Общий секрет для планировщика. Запросы к /api/scheduled/* без него
# отвергаются. Оставьте пустым, чтобы полностью выключить эти эндпоинты.
CRON_SECRET=

# Railway подставляет PORT сам; локально можно не задавать.
# PORT=3000
